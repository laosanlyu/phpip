# phpIP Production Environment Configuration
# Copy this file to .env before running: docker compose -f docker-compose.prod.yml up -d

APP_NAME=phpIP
COMPANY_NAME="Computime"
APP_ENV=production
APP_KEY=base64:G2MPEpty7uyKrOyW1EjYqIhlhgXW0ycFhgfuSSUX0F0=
APP_DEBUG=false
APP_URL=http://10.11.4.51

# Locale Settings
APP_LOCALE=en_US
APP_TIMEZONE=UTC

# Logging
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Database Configuration - MySQL 8.0
# IMPORTANT: Change these passwords before deployment!
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=phpip
DB_USERNAME=phpip
DB_PASSWORD=phpip_password
DB_ROOT_PASSWORD=root_password

# Cache and Session - Redis (recommended for production)
CACHE_DRIVER=redis
SESSION_DRIVER=redis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Session settings for multi-hostname access
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

# Queue Configuration
QUEUE_CONNECTION=database
BROADCAST_DRIVER=log
FILESYSTEM_DISK=local
SESSION_LIFETIME=120

# Mail Configuration - PRODUCTION SMTP
# Configure with your email provider (Gmail, SendGrid, etc.)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@your-domain.com
MAIL_FROM_NAME="${APP_NAME}"
MAIL_TO=admin@your-domain.com

# OPTIONAL: EPO Open Patent Services API
# Register at https://developers.epo.org/
OPS_APP_KEY=
OPS_SECRET=

# OPTIONAL: Renewr API Integration
RENEWR_API_URL=
RENEWR_API_KEY=

# OPTIONAL: SharePoint Integration
SHAREPOINT_ENABLED=false
SHAREPOINT_API_URL=
SHAREPOINT_TOKEN_URL=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_RESOURCE=
SHAREPOINT_FOLDER_PATH=
SHAREPOINT_EVENT_CODES=

# Docker Ports
NGINX_PORT=80
NGINX_SSL_PORT=443
