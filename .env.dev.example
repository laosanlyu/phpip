# phpIP Development Environment Configuration
# Copy this file to .env before running: docker compose -f docker-compose.dev.yml up -d

APP_NAME=phpIP-Dev
COMPANY_NAME="Development"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# Locale Settings
APP_LOCALE=en_US
APP_TIMEZONE=UTC

# Logging - verbose for development
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration - MySQL 8.0 (dev instance)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=phpip_dev
DB_USERNAME=phpip
DB_PASSWORD=dev_password_123
DB_ROOT_PASSWORD=dev_root_123

# Cache and Session - File based for easier debugging
CACHE_DRIVER=file
SESSION_DRIVER=file
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Queue Configuration - Sync for immediate feedback
QUEUE_CONNECTION=sync
BROADCAST_DRIVER=log
FILESYSTEM_DISK=local
SESSION_LIFETIME=120

# Mail Configuration - Use Mailtrap for testing
# Sign up at https://mailtrap.io for free email testing
MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your-mailtrap-username
MAIL_PASSWORD=your-mailtrap-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=dev@localhost
MAIL_FROM_NAME="${APP_NAME}"
MAIL_TO=dev@localhost

# OPTIONAL: EPO Open Patent Services API
OPS_APP_KEY=
OPS_SECRET=

# OPTIONAL: Renewr API Integration
RENEWR_API_URL=
RENEWR_API_KEY=

# OPTIONAL: SharePoint Integration
SHAREPOINT_ENABLED=false
SHAREPOINT_API_URL=
SHAREPOINT_TOKEN_URL=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_RESOURCE=
SHAREPOINT_FOLDER_PATH=
SHAREPOINT_EVENT_CODES=

# Docker Ports - Different from production to avoid conflicts
NGINX_PORT=8080
NGINX_SSL_PORT=8443
